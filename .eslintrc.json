{
  "env": { "browser": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "rules": {
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "no-unused-vars": "warn",
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "env": { "node": true },
      "globals": {
        "vi": "readonly",
        "describe": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "global": "writable"
      }
    }
  ]
}
